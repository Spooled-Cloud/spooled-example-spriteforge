# ═══════════════════════════════════════════════════════════════════════════
# SPRITEFORGE ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED - Spooled API Key
# ─────────────────────────────────────────────────────────────────────────────
# Get your API key from https://dashboard.spooled.cloud
# For self-hosted Spooled, create a key via the admin API

SPOOLED_API_KEY=sp_live_your_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR PRODUCTION - Cloudflare Tunnel
# ─────────────────────────────────────────────────────────────────────────────
# Only needed when using docker-compose.prod.yml
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels

# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiNTM...your_tunnel_token_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Spooled Connection
# ─────────────────────────────────────────────────────────────────────────────
# For Spooled Cloud (default):
#   SPOOLED_BASE_URL=https://api.spooled.cloud
#   SPOOLED_WS_URL=wss://api.spooled.cloud
#
# For self-hosted Spooled:
#   SPOOLED_BASE_URL=http://localhost:8080
#   SPOOLED_WS_URL=ws://localhost:8080

SPOOLED_BASE_URL=https://api.spooled.cloud
SPOOLED_WS_URL=wss://api.spooled.cloud

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Port to listen on (default: 3000)
PORT=3000

# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Node environment (default: production)
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Queue Names
# ─────────────────────────────────────────────────────────────────────────────
# Customize queue names if needed (defaults work for most setups)

QUEUE_FRAMES=spriteforge-frames
QUEUE_ASSEMBLE=spriteforge-assemble
QUEUE_PUBLIC=spriteforge-public

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Worker Concurrency
# ─────────────────────────────────────────────────────────────────────────────
# How many jobs each worker processes in parallel

# Frame generation workers (default: 8)
WORKER_CONCURRENCY_FRAMES=8

# Sprite assembly workers (default: 2)
WORKER_CONCURRENCY_ASSEMBLE=2

# Public sprite workers (default: 1)
WORKER_CONCURRENCY_PUBLIC=1

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - "Sprite of the Minute" Schedule
# ─────────────────────────────────────────────────────────────────────────────
# Automatically generates a random sprite every minute

# Enable/disable the public sprite schedule (default: true)
ENABLE_PUBLIC_SCHEDULE=true

# Schedule name (default: demo-random-sprite)
PUBLIC_SCHEDULE_NAME=demo-random-sprite

# Cron expression - 6 fields (second minute hour day month weekday)
# Default: every minute at :00 seconds
PUBLIC_SCHEDULE_CRON=0 * * * * *

# Timezone for the schedule (default: UTC)
PUBLIC_SCHEDULE_TIMEZONE=UTC

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Job Retention / Cleanup
# ─────────────────────────────────────────────────────────────────────────────
# Jobs created by this demo have an expires_at timestamp.
# After expiration, jobs are automatically cleaned up by the Spooled backend.
#
# For high-traffic public demos, use a shorter retention (1-4 hours).
# For development/testing, longer retention (24 hours) makes debugging easier.

# Hours until demo jobs expire (default: 24)
JOB_RETENTION_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL - Docker Image (for docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Override the Docker image used in production

# SPRITEFORGE_IMAGE=ghcr.io/spooled-cloud/spooled-example-spriteforge:latest
